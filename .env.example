# Variables de entorno - Plataforma Digital CERIC
# Copia este archivo como .env.local y completa los valores

# Base de datos PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/plataforma_ceric?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-secret-seguro-aqui"

# Resend (envío de emails)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
