# ================================================
# PLATAFORMA DIGITAL CERIC - Variables de Entorno
# ================================================

# Base de datos PostgreSQL (OBLIGATORIO)
DATABASE_URL="postgresql://usuario:password@localhost:5432/ceric"

# Autenticación NextAuth (OBLIGATORIO)
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Email transaccional con Resend (OBLIGATORIO para emails)
# Crear cuenta gratuita en: https://resend.com
RESEND_API_KEY=""

# Google Maps - Para el mapa en la página de contacto
# Obtener en: https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Cloudinary - Para almacenamiento de imágenes (opcional en v1)
# Crear cuenta en: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
